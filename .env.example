# Public analytics ID (future phase)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Public WhatsApp destination (future phase)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Server-only contact destination (future phase)
CONTACT_EMAIL=

# Server-only mail provider key (future phase)
MAIL_API_KEY=

# Google Tag Manager (Etapa 1 - Marketing Layer)
# Contenedor dedicado exclusivamente para etiquetas de marketing (e.g. Meta Pixel)
# Formato esperado: GTM-XXXXXXX
NEXT_PUBLIC_GTM_ID=GTM-5HHWCMLX

# Interruptor de activación de Google Tag Manager (true / false)
# IMPORTANTE: Al ser una variable con prefijo NEXT_PUBLIC_, Next.js la incrusta en el bundle cliente
# durante el proceso de compilación (build time). Cualquier cambio en este valor REQUIERE una
# recompilación (build) y un nuevo despliegue (redeploy) para surtir efecto en producción.
# NO funciona como una desactivación remota instantánea en tiempo de ejecución.
NEXT_PUBLIC_GTM_ENABLED=true
